<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView android:text="Hermes Lite" android:textSize="24sp" android:textStyle="bold"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/hermesStatus" android:text="Ready"
        android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <ScrollView android:id="@+id/chatScroll" android:layout_weight="1"
        android:layout_width="match_parent" android:layout_height="0dp">
        <TextView android:id="@+id/chatLog" android:textSize="15sp" android:textIsSelectable="true"
            android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </ScrollView>

    <EditText android:id="@+id/input" android:hint="Ketik pesan..." android:minLines="2" android:maxLines="5"
        android:gravity="top|start" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/sendBtn" android:text="SEND" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content"/>
        <Button android:id="@+id/clearBtn" android:text="CLEAR" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content"/>
    </LinearLayout>

    <EditText android:id="@+id/systemPrompt" android:hint="System prompt / persona" android:minLines="2" android:maxLines="4"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <EditText android:id="@+id/memoryBox" android:hint="Memory notes" android:minLines="2" android:maxLines="4"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Button android:id="@+id/saveMemoryBtn" android:text="SAVE PERSONA + MEMORY"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
